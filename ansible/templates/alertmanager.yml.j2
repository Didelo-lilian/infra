global:
  smtp_smarthost: smtp.gmail.com:587
  smtp_from: "{{ alert_email }}"
  smtp_auth_username: "{{ alert_email }}"
  smtp_auth_password_file: /run/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: email
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

receivers:
  - name: email
    email_configs:
      - to: "{{ alert_email }}"
        send_resolved: true
